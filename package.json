{
  "name": "envguard",
  "version": "0.1.0",
  "description": "Type-safe environment variable validation at startup. Framework-agnostic, zero rewrite of process.env, fails fast with clear errors.",
  "keywords": [
    "env",
    "environment-variables",
    "validation",
    "zod",
    "typescript",
    "config",
    "startup-validation",
    "process.env"
  ],
  "author": "Abdul Moiz",
  "license": "MIT",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md"],
  "peerDependencies": {
    "zod": ">=3"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm build && pnpm test"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0",
    "zod": "^3.22.0"
  }
}
